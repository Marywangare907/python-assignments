class Smartphone:
    def __init__(self, brand, model, price):
        self.brand = brand
        self.model = model
        self.price = price

    def call(self, number):
        return f"Calling {number} from {self.model}..."

    def browse(self, website):
        return f"Browsing {website} on {self.model}."

class Smartwatch(Smartphone):  # Inheritance
    def __init__(self, brand, model, price, battery_life):
        super().__init__(brand, model, price)
        self.battery_life = battery_life

    def track_steps(self, steps):
        return f"Tracking {steps} steps on {self.model}."
# Example usage:
phone = Smartphone("Apple", "iPhone 14", 999)   
watch = Smartwatch("Samsung", "Galaxy Watch", 299, "48 hours")

print(phone.call("123-456-7890"))
print(watch.track_steps(5000))




lass Vehicle:
